{
  "$schema": "./schemas/capabilities.schema.json",
  "schemaVersion": 1,
  "package": {
    "name": "livis-relay-daemon",
    "version": "0.1.1",
    "license": "MIT",
    "language": "zh-CN",
    "phase": "phase1-multi-backend",
    "officialEndorsement": false
  },
  "compatibility": {
    "bun": ">=1.3.14",
    "python": ">=3.11,<3.14",
    "hermesRuntime": ">=0.15.1,<0.15.2",
    "hermesBridge": ">=0.1.1,<0.2.0",
    "codexCli": ">=0.145.0,<0.146.0",
    "claudeCli": "version-observational; required flags + stream-json capability probe",
    "livisReferenceClient": "2.0.0",
    "livisProtocolStatus": "observed-not-publicly-versioned",
    "lastReviewed": "2026-07-27"
  },
  "topology": {
    "relayStateOwner": "livis-relayd",
    "connectorTransport": "unix-websocket",
    "connectorAuthentication": "bearer-and-lease-fencing",
    "oneDaemonPerStateDirectory": true,
    "dedicatedHermesProfileRequired": true
  },
  "capabilities": [
    {
      "id": "inbound_text",
      "direction": "livis-to-hermes",
      "status": "live-canary-verified",
      "evidenceRefs": ["docs/HERMES-CANARY.md"],
      "testRefs": ["tests/python_connector_integration.test.ts", "tests/relay_client.test.ts"],
      "notes": "LiViS 文本任务可经 daemon 和 UDS connector 进入专用 Hermes Gateway。"
    },
    {
      "id": "outbound_final_text",
      "direction": "hermes-to-livis",
      "status": "live-canary-verified",
      "evidenceRefs": ["docs/HERMES-CANARY.md"],
      "testRefs": ["tests/python_connector_integration.test.ts", "tests/relay_client.test.ts"],
      "notes": "一期只允许单个纯文本 final result，并以 durable outbox 等待远端 ACK。"
    },
    {
      "id": "durable_result_delivery",
      "direction": "hermes-to-livis",
      "status": "live-canary-verified",
      "evidenceRefs": ["docs/HERMES-CANARY.md", "docs/ARCHITECTURE.md"],
      "testRefs": ["tests/store.test.ts", "tests/relay_client.test.ts"],
      "notes": "Agent 至多执行一次，结果至少投递一次；重启只重放未完成 outbox。"
    },
    {
      "id": "request_cancellation",
      "direction": "bidirectional",
      "status": "offline-verified",
      "evidenceRefs": ["docs/ARCHITECTURE.md", "docs/SECURITY.md"],
      "testRefs": ["tests/store.test.ts", "tests/connector.test.ts", "hermes-plugin/tests/test_adapter.py"],
      "notes": "取消为 best effort；无法证明工具线程退出时进入 CancelUnknown 并隔离 session。"
    },
    {
      "id": "payload_conflict_detection",
      "direction": "local",
      "status": "offline-verified",
      "evidenceRefs": ["docs/ARCHITECTURE.md"],
      "testRefs": ["tests/store.test.ts"],
      "notes": "同一 scope 和 job_id 的业务 payload hash 不一致时失败关闭。"
    },
    {
      "id": "lease_fencing",
      "direction": "local",
      "status": "offline-verified",
      "evidenceRefs": ["docs/ARCHITECTURE.md"],
      "testRefs": ["tests/connector.test.ts", "tests/store.test.ts", "hermes-plugin/tests/test_adapter.py"],
      "notes": "lease_id 和 run_generation 阻止旧 connector 或迟到结果完成新执行。"
    },
    {
      "id": "upstream_drift_guard",
      "direction": "local",
      "status": "offline-verified",
      "evidenceRefs": ["docs/UPSTREAM-UPGRADE.md", "docs/SECURITY.md"],
      "testRefs": ["tests/upstream.test.ts", "tests/proof.test.ts", "tests/activation.test.ts"],
      "notes": "active profile、artifact 哈希、wire marker 和近期 supported proof 不满足时拒绝新任务。"
    },
    {
      "id": "hermes_bridge_installation",
      "direction": "local",
      "status": "operator-only",
      "evidenceRefs": ["docs/OPERATIONS.md"],
      "testRefs": ["tests/hermes_installer.test.ts"],
      "notes": "只在操作者提供明确专用 HERMES_HOME 后原子安装；不会启动或重启 Gateway。"
    },
    {
      "id": "audited_release_deployment",
      "direction": "local",
      "status": "operator-only",
      "evidenceRefs": ["docs/DEPLOYMENT-INSTALLER.md", "docs/OPERATIONS.md", "docs/RELEASING.md"],
      "testRefs": ["tests/deployment_boundary.test.ts", "tests/deployment_installer.test.ts", "tests/deployment_service.test.ts", "tests/deployment_cli.test.ts", "tests/release_artifacts.test.ts"],
      "notes": "deploy plan/install/upgrade/rollback/uninstall 只消费由操作者固定 SHA-256 的 clean-git release manifest 与审计归档，使用不可变 release、私有收据和显式服务副作用确认；不读取、复制、迁移或判断 Hermes、Codex、Claude 原生认证状态。真实 launchd/systemd 安装、升级和回滚 canary 尚未执行。"
    },
    {
      "id": "codex_app_server_execution",
      "direction": "bidirectional",
      "status": "live-canary-verified",
      "evidenceRefs": ["docs/CODEX-APPSERVER.md", "docs/CODEX-E2E-CANARY.md"],
      "testRefs": ["tests/codex_execution_backend.test.ts", "tests/codex_app_server_client.test.ts"],
      "notes": "实验性 Codex app-server backend 已完成受控执行 canary；当前使用 daemon 私有 CODEX_HOME 与专用 API key，不代表复用用户当前 Codex 登录态或生产可用。"
    },
    {
      "id": "codex_native_auth_reuse",
      "direction": "local",
      "status": "operator-only",
      "evidenceRefs": ["docs/LOCAL-BACKENDS.md", "docs/CODEX-NATIVE-AUTH.md"],
      "testRefs": ["tests/auth_boundary.test.ts", "tests/local_backend_contract.test.ts", "tests/codex_native_stdio.test.ts", "tests/codex_native_client_epoch.test.ts", "tests/codex_native_execution_lifecycle.test.ts", "tests/codex_native_thread_policy.test.ts", "tests/codex_native_session_coordinator.test.ts", "tests/codex_native_session_harness.test.ts", "tests/codex_native_execution_backend.test.ts", "tests/backend_switch.test.ts"],
      "notes": "显式 codex.mode=native-current 可由操作者接入 Relay 自管的 codex app-server --stdio 子进程；只透传 HOME/CODEX_HOME 等 runtime 选择器，不读取、复制、分类或刷新账号凭据，也不连接 Desktop daemon。兼容性由 initialize 协议握手裁决，不以固定 CLI 版本窗阻断。生产接线、原子 backend switch、离线门禁与真实 LiViS 文本闭环已有证据；真实 session resume/异常路径、工具执行与 Desktop 长时并发 canary 尚未闭合，因此仅为 operator-only。旧 private-api-key 路径必须显式选择且不会被静默 fallback。"
    },
    {
      "id": "claude_execution",
      "direction": "bidirectional",
      "status": "operator-only",
      "evidenceRefs": ["docs/LOCAL-BACKENDS.md", "docs/CLAUDE-NATIVE.md"],
      "testRefs": ["tests/local_backend_contract.test.ts", "tests/auth_boundary.test.ts", "tests/claude_native_cli.test.ts", "tests/claude_native_execution_backend.test.ts", "tests/daemon_execution_backend.test.ts", "tests/backend_switch.test.ts", "tests/codex_cli_doctor.test.ts"],
      "notes": "显式 claude.mode=native-current 已接入 Claude Code --print/stream-json 的单任务纯文本安全路径。Relay 从空环境构造白名单，只把 HOME 作为当前 runtime 选择器交给 Claude，自身不读取、复制、分类或刷新账号状态。版本只作观察，readiness 由 version/help 必需参数与 system/init 安全回读裁决。工具、MCP、skills、Hook、Chrome、slash command 和 session persistence 均禁用；提交状态、断连、取消和 ambiguous execution 已映射到 JobStore v8。真实 LiViS App 单条文本闭环已有回执；错误态、取消/超时/崩溃、长时运行、工具执行和原生会话恢复尚未完成，因此保持 operator-only。"
    },
    {
      "id": "assistant_context_read_only",
      "direction": "local",
      "status": "offline-verified",
      "evidenceRefs": ["docs/ASSISTANT-CONTEXT.md", "docs/LOCAL-BACKENDS.md", "docs/SECURITY.md"],
      "testRefs": ["tests/assistant_context.test.ts", "tests/codex_native_execution_backend.test.ts", "tests/claude_native_execution_backend.test.ts", "tests/auth_boundary.test.ts"],
      "notes": "可选 assistantContext 从 stateDir 外的操作者私有目录双遍加载 AGENTS.md 与有界 memory Markdown，生成无时间戳的确定性 manifest，并在 Codex harness/每轮 dispatch 或 Claude 每轮 spawn 前恢复私有 workspace 快照。canonical context 只读，不自动写回，不包含认证管理；真实 LiViS 长期记忆 canary 尚未执行。"
    },
    {
      "id": "online_multi_backend_routing",
      "direction": "local",
      "status": "unsupported",
      "evidenceRefs": ["docs/LOCAL-BACKENDS.md"],
      "testRefs": [],
      "notes": "当前一套 daemon 只选择一个 execution backend；在线同时连接并按 session 切换尚未实现。"
    },
    {
      "id": "document_delivery",
      "direction": "hermes-to-livis",
      "status": "unsupported",
      "evidenceRefs": ["README.md"],
      "testRefs": ["hermes-plugin/tests/test_adapter.py"],
      "notes": "一期不读取或上传附件。"
    },
    {
      "id": "streaming_and_tool_progress",
      "direction": "hermes-to-livis",
      "status": "unsupported",
      "evidenceRefs": ["README.md", "docs/SECURITY.md"],
      "testRefs": ["hermes-plugin/tests/test_adapter.py"],
      "notes": "一期关闭 streaming、tool progress 和 interim assistant messages。"
    },
    {
      "id": "remote_approval_and_admin",
      "direction": "bidirectional",
      "status": "unsupported",
      "evidenceRefs": ["README.md", "docs/SECURITY.md"],
      "testRefs": ["hermes-plugin/tests/test_adapter.py"],
      "notes": "不支持远程审批、远程更新或其他管理命令。"
    },
    {
      "id": "unsolicited_push",
      "direction": "hermes-to-livis",
      "status": "unsupported",
      "evidenceRefs": ["README.md"],
      "testRefs": [],
      "notes": "一期只响应 LiViS 发起的 on-demand 请求。"
    }
  ],
  "safetyDefaults": {
    "allowAllNodes": false,
    "allowAllHermesUsers": false,
    "streaming": false,
    "toolProgress": false,
    "remoteApproval": false,
    "remoteAdmin": false,
    "nativeBackendCredentialReuse": false,
    "onlineBackendRouting": false,
    "unknownProtocol": "fail-closed"
  },
  "commands": {
    "readOnly": [
      "capabilities",
      "status",
      "doctor",
      "claude probe-native-cli",
      "deploy plan",
      "version"
    ],
    "localStateMutation": [
      "init",
      "upstream check",
      "upstream activate",
      "upstream rollback",
      "profile migrate-v2",
      "profile rollback-migration",
      "backend switch",
      "session release",
      "codex smoke-app-server",
      "codex probe-native-app-server",
      "install-hermes-plugin install",
      "install-hermes-plugin rollback",
      "deploy install",
      "deploy upgrade",
      "deploy rollback",
      "deploy uninstall"
    ],
    "externalStateMutation": [
      "login",
      "logout",
      "serve"
    ],
    "explicitAcknowledgementRequired": [
      "init --acknowledge-unofficial-protocol",
      "upstream activate --acknowledge-reviewed-profile",
      "upstream rollback --acknowledge-rollback",
      "install-hermes-plugin rollback --acknowledge-rollback",
      "backend switch --apply --acknowledge-daemon-stopped --acknowledge-remote-execution",
      "deploy install/upgrade --apply",
      "deploy rollback --apply --acknowledge-state-compatibility",
      "deploy uninstall --apply --acknowledge-uninstall",
      "deploy --manage-service --acknowledge-service-restart"
    ]
  },
  "network": {
    "productionEndpointsBundled": false,
    "officialOauthIdentityBundled": false,
    "authorizedProfileRequired": true,
    "connectorListensOnTcp": false
  },
  "localData": [
    {
      "path": "<stateDir>/secrets.json",
      "mode": "0600",
      "contains": ["refresh token", "connector bearer token"],
      "retention": "operator-managed"
    },
    {
      "path": "<stateDir>/identity.json",
      "mode": "0600",
      "contains": ["relay agent id", "device id"],
      "retention": "operator-managed"
    },
    {
      "path": "<stateDir>/relay.db*",
      "mode": "0600",
      "contains": ["node id", "message content", "delivery and execution state"],
      "retention": "until-explicit-cleanup"
    },
    {
      "path": "<stateDir>/",
      "mode": "0700",
      "contains": ["protocol profile", "supported proof", "upstream audit artifact"],
      "retention": "operator-managed"
    },
    {
      "path": "<stateDir>/backends/codex/home",
      "mode": "0700",
      "contains": ["Codex API key authentication state", "Codex thread and rollout state"],
      "retention": "operator-managed"
    },
    {
      "path": "<stateDir>/backends/codex/native-sessions",
      "mode": "0700",
      "contains": ["Codex opaque thread id", "workspace files", "session checkpoint metadata"],
      "retention": "operator-managed"
    },
    {
      "path": "<stateDir>/backends/claude/native-sessions",
      "mode": "0700",
      "contains": ["opaque JobStore session anchor", "stateless workspace", "private runtime temp files"],
      "retention": "operator-managed"
    },
    {
      "path": "<assistantContext.contextDir>",
      "mode": "0700",
      "contains": ["AGENTS.md instructions", "operator-managed read-only memory Markdown"],
      "retention": "operator-managed"
    },
    {
      "path": "<installRoot>",
      "mode": "0700",
      "contains": ["immutable release trees", "deployment pointer", "private deployment receipts", "audited release bundle snapshot"],
      "retention": "until-explicit-cleanup"
    }
  ],
  "release": {
    "artifacts": ["source-tarball", "hermes-bridge-tarball"],
    "manifest": "release-manifest.json",
    "requiredGates": [
      "version consistency",
      "capability schema and reference validation",
      "tracked-file public release audit",
      "archive extraction and content audit",
      "TypeScript typecheck",
      "Bun tests",
      "Hermes pytest"
    ]
  }
}
