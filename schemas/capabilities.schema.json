{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jassy930/livis-relay-daemon/schemas/capabilities.schema.json",
  "title": "LiViS Relay Daemon 能力契约",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "package",
    "compatibility",
    "topology",
    "capabilities",
    "safetyDefaults",
    "commands",
    "network",
    "localData",
    "release"
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "$schema": {
      "const": "./schemas/capabilities.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "license", "language", "phase", "officialEndorsement"],
      "properties": {
        "name": { "const": "livis-relay-daemon" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "license": { "const": "MIT" },
        "language": { "const": "zh-CN" },
        "phase": { "const": "phase1-multi-backend" },
        "officialEndorsement": { "const": false }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bun",
        "python",
        "hermesRuntime",
        "hermesBridge",
        "codexCli",
        "livisReferenceClient",
        "livisProtocolStatus",
        "lastReviewed"
      ],
      "properties": {
        "bun": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "hermesRuntime": { "type": "string", "minLength": 1 },
        "hermesBridge": { "type": "string", "minLength": 1 },
        "codexCli": { "type": "string", "minLength": 1 },
        "livisReferenceClient": { "type": "string", "minLength": 1 },
        "livisProtocolStatus": { "const": "observed-not-publicly-versioned" },
        "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relayStateOwner",
        "connectorTransport",
        "connectorAuthentication",
        "oneDaemonPerStateDirectory",
        "dedicatedHermesProfileRequired"
      ],
      "properties": {
        "relayStateOwner": { "const": "livis-relayd" },
        "connectorTransport": { "const": "unix-websocket" },
        "connectorAuthentication": { "const": "bearer-and-lease-fencing" },
        "oneDaemonPerStateDirectory": { "const": true },
        "dedicatedHermesProfileRequired": { "const": true }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "direction", "status", "evidenceRefs", "testRefs", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "direction": {
            "enum": ["livis-to-hermes", "hermes-to-livis", "bidirectional", "local"]
          },
          "status": {
            "enum": ["live-canary-verified", "offline-verified", "operator-only", "unsupported"]
          },
          "evidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/relativePath" }
          },
          "testRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/relativePath" }
          },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "safetyDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowAllNodes",
        "allowAllHermesUsers",
        "streaming",
        "toolProgress",
        "remoteApproval",
        "remoteAdmin",
        "nativeBackendCredentialReuse",
        "onlineBackendRouting",
        "unknownProtocol"
      ],
      "properties": {
        "allowAllNodes": { "const": false },
        "allowAllHermesUsers": { "const": false },
        "streaming": { "const": false },
        "toolProgress": { "const": false },
        "remoteApproval": { "const": false },
        "remoteAdmin": { "const": false },
        "nativeBackendCredentialReuse": { "const": false },
        "onlineBackendRouting": { "const": false },
        "unknownProtocol": { "const": "fail-closed" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "localStateMutation", "externalStateMutation", "explicitAcknowledgementRequired"],
      "properties": {
        "readOnly": { "$ref": "#/$defs/nonEmptyStringArray" },
        "localStateMutation": { "$ref": "#/$defs/nonEmptyStringArray" },
        "externalStateMutation": { "$ref": "#/$defs/nonEmptyStringArray" },
        "explicitAcknowledgementRequired": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionEndpointsBundled",
        "officialOauthIdentityBundled",
        "authorizedProfileRequired",
        "connectorListensOnTcp"
      ],
      "properties": {
        "productionEndpointsBundled": { "const": false },
        "officialOauthIdentityBundled": { "const": false },
        "authorizedProfileRequired": { "const": true },
        "connectorListensOnTcp": { "const": false }
      }
    },
    "localData": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "contains", "retention"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["0600", "0700"] },
          "contains": { "$ref": "#/$defs/nonEmptyStringArray" },
          "retention": { "enum": ["operator-managed", "until-logout", "until-explicit-cleanup"] }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "manifest", "requiredGates"],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["source-tarball", "hermes-bridge-tarball"] }
        },
        "manifest": { "const": "release-manifest.json" },
        "requiredGates": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    }
  }
}
